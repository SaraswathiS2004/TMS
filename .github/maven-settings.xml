<settings>
    <servers>
        <!-- Read configM from GitHub Packages -->
        <server>
            <id>github-configM</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.PACKAGES_TOKEN}</password>
        </server>
        <!-- Publish TMS to GitHub Packages -->
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.PACKAGES_TOKEN}</password>
        </server>
    </servers>
</settings>
