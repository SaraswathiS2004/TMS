<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
 <!-- 1. Registers authx ADMIN_USERS schema + OrmContext ready listener that checks
            if an admin already exists and marks AuthContext as configured. -->
    <listener>
        <listener-class>com.authx.web.AuthSetupListener</listener-class>
    </listener>
    <!-- OrmX bootstrap — connects to DB, runs schema migration, manages sheet sync -->
    <listener>
        <listener-class>com.ormx.web.OrmSetupListener</listener-class>
    </listener>

    <!-- Redirect /api/* to setup wizard until DB is configured -->
    <filter>
        <filter-name>OrmSetupFilter</filter-name>
        <filter-class>com.ormx.web.OrmSetupFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>OrmSetupFilter</filter-name>
        <url-pattern>*</url-pattern>
    </filter-mapping>

<!--  Redirects all requests to the authx wizard until an admin user exists.
            Runs AFTER OrmSetupFilter so the OrmX wizard takes priority. -->
    <filter>
        <filter-name>AuthSetupFilter</filter-name>
        <filter-class>com.authx.web.AuthSetupFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthSetupFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Serves the OrmX first-run setup wizard UI -->
    <servlet>
        <servlet-name>OrmSetupServlet</servlet-name>
        <servlet-class>com.ormx.web.OrmSetupServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrmSetupServlet</servlet-name>
        <url-pattern>/orm-setup/*</url-pattern>
    </servlet-mapping>

         <!-- Auth setup wizard UI (admin credential setup on first boot) -->
    <servlet>
        <servlet-name>AuthSetupServlet</servlet-name>
        <servlet-class>com.authx.web.AuthSetupServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthSetupServlet</servlet-name>
        <url-pattern>/authx-setup/*</url-pattern>
    </servlet-mapping>


    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.tms.servlets.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>PeopleServlet</servlet-name>
        <servlet-class>com.tms.servlets.PeopleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PeopleServlet</servlet-name>
        <url-pattern>/api/people</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FunctionServlet</servlet-name>
        <servlet-class>com.tms.servlets.FunctionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FunctionServlet</servlet-name>
        <url-pattern>/api/functions</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PersonFunctionServlet</servlet-name>
        <servlet-class>com.tms.servlets.PersonFunctionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PersonFunctionServlet</servlet-name>
        <url-pattern>/api/person-function</url-pattern>
    </servlet-mapping>

</web-app>
